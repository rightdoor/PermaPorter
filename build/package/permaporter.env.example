# PermaPorter 环境配置示例（复制为 /etc/default/permaporter）
# 注意：启动必需项（数据库与五端口）优先从服务器配置文件 permaporter.toml 读取
#（取值优先级：配置文件 > 环境变量 > 默认值；文件在 CONFIG_DIR 下首次启动自动生成，
# systemd 单元已预设 CONFIG_DIR=/var/lib/permaporter/config，见 docs/configuration.md）

# 服务器配置文件目录（存放 permaporter.toml；须为运行用户可写的绝对路径，
# 不要放 /etc 下——单元 ProtectSystem=strict 使 /etc 只读，向导写回会失败）
#CONFIG_DIR=/var/lib/permaporter/config

# 五端口（配置文件 [ports] 段优先生效；改端口后需同步修改客户端配置与防火墙规则）
UI_PORT=9090
NPM_PORT=9091
GO_PORT=9092
PY_PORT=9093
MVN_PORT=9094

# 单库（配置文件 [database] 段优先后此项不再生效；permaporter.db：平台凭据 + 全部生态数据，
# 表名 go_*/npm_*/py_*/mvn_* 前缀隔离）
#DB_DSN=file:/var/lib/permaporter/data/permaporter.db?_busy_timeout=30000&_foreign_keys=1&_journal_mode=DELETE

# 四棵存储树（两两互异且互不为父子——启动校验强制，违反即拒绝启动）
#GO_STORAGE_DIR=/var/lib/permaporter/data/storage-go
#NPM_STORAGE_DIR=/var/lib/permaporter/data/storage-npm
#PY_STORAGE_DIR=/var/lib/permaporter/data/storage-py
#MVN_STORAGE_DIR=/var/lib/permaporter/data/storage-mvn

# 各生态默认上游（初始化时写入 ecosystem_settings，之后可在后台按生态修改）
#DEFAULT_GO_UPSTREAM=https://proxy.golang.org
#DEFAULT_GO_FALLBACK_UPSTREAM=
#DEFAULT_NPM_UPSTREAM=https://registry.npmjs.org
#DEFAULT_PY_UPSTREAM=https://pypi.org/simple/
#DEFAULT_MVN_UPSTREAM=https://repo.maven.apache.org/maven2

# 元数据 TTL 初始值（首次初始化写入 ecosystem_settings.meta_ttl，此后以库内值为准）
#META_TTL=2m

# 首次启动初始化密码（数据库已配置时自动写入；数据库未配置时打开控制台自动进入部署向导）
#INIT_PASSWORD=

# UNATTENDED=1 无头模式（CI/测试/脚本）：跳过初始化向导，数据库未配置时按默认 SQLite 启动
#UNATTENDED=

# 初始化向导访问令牌（可选；未初始化前向导对网络开放，公网部署建议设置）
#INIT_TOKEN=

# PPROF=1 开启 /debug/pprof（仅 9090，需管理员登录）
#PPROF=
