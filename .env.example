# PermaPorter 环境变量模板（复制为运行环境的环境配置，如 /etc/default/permaporter）
# 与代码实际读取的变量一一对应（见 internal/config/config.go）；未设置的变量使用默认值。
# 注意：启动必需项（数据库与五端口）优先从服务器配置文件 CONFIG_DIR/permaporter.toml
# 读取（取值优先级：配置文件 > 环境变量 > 默认值），文件首次启动自动生成模板。

# ---------- 服务器配置文件 ----------
# 配置目录（默认 ./config，容器内 /app/config）；存放 permaporter.toml：
# 数据库（driver = sqlite | postgresql）与五端口，修改后需重启生效
#CONFIG_DIR=./config

# ---------- 五端口（互不相同，违反即拒绝启动；配置文件 [ports] 段优先生效） ----------
UI_PORT=9090
NPM_PORT=9091
GO_PORT=9092
PY_PORT=9093
MVN_PORT=9094

# ---------- 单库路径（配置文件 [database] 段优先生效） ----------
# data/permaporter.db 承载平台凭据与全部生态数据（表名 go_*/npm_*/py_*/mvn_* 前缀隔离）
#DB_DSN=file:./data/permaporter.db?_busy_timeout=30000&_foreign_keys=1&_journal_mode=DELETE

# ---------- 四棵存储树（两两互不相同且互不为父子，违反即拒绝启动） ----------
#GO_STORAGE_DIR=./data/storage-go
#NPM_STORAGE_DIR=./data/storage-npm
#PY_STORAGE_DIR=./data/storage-py
#MVN_STORAGE_DIR=./data/storage-mvn

# ---------- 各生态默认上游（首次初始化时写入 ecosystem_settings，之后在控制台按生态修改） ----------
#DEFAULT_GO_UPSTREAM=https://proxy.golang.org
#DEFAULT_GO_FALLBACK_UPSTREAM=
#DEFAULT_NPM_UPSTREAM=https://registry.npmjs.org
#DEFAULT_PY_UPSTREAM=https://pypi.org/simple/
#DEFAULT_MVN_UPSTREAM=https://repo.maven.apache.org/maven2

# ---------- 其他 ----------
# 元数据刷新间隔初始值（首次初始化写入 ecosystem_settings.meta_ttl，此后以库内值为准；各生态共用；Go duration 格式）
#META_TTL=2m

# 首次启动自动初始化管理员密码（写入 platform_settings；仅数据库已配置时生效——数据库未配置时打开控制台自动进入部署向导）
#INIT_PASSWORD=

# 1 开启无头模式（CI/测试/脚本）：跳过初始化向导判定，数据库未配置时按默认 SQLite 正常启动
#UNATTENDED=

# 初始化向导访问令牌（可选；设置后向导第一步需先输入令牌。未初始化前向导对网络开放，
# 公网部署建议设置，完成初始化后可移除）
#INIT_TOKEN=

# 1 开启 /debug/pprof（仅 9090，需管理员登录）
#PPROF=
